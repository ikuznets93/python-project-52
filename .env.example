# Django
SECRET_KEY=your-secret-key
# True for local development, False in production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated list of trusted origins, e.g. https://myapp.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Database (empty = SQLite, production = postgres://user:password@host:5432/dbname)
DATABASE_URL=

# Email (used when DEBUG=False)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Production security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
